NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA4_ID=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
DEMO_SEED_ENABLED=false
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
EMAIL_PROVIDER=resend
EMAIL_FROM=Thiện Nguyện <no-reply@example.com>
RESEND_API_KEY=your-resend-key
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=Thiện Nguyện <no-reply@example.com>
RESCUE_INVITATION_FROM_EMAIL=Thiện Nguyện <no-reply@example.com>
# Must match the Supabase Auth email invite expiry setting (default: 1 hour).
RESCUE_INVITATION_EXPIRY_HOURS=1
# Đăng ký merchant sandbox tại https://sandbox.vnpayment.vn/devreg để lấy TMN Code và Hash Secret.
# Bỏ trống hai biến này thì nút "Thanh toán qua VNPAY" sẽ báo lỗi cấu hình và gợi ý dùng VietQR thủ công.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Nhận email mỗi khi có giao dịch chuyển khoản thủ công (VietQR/nạp ví) mới đang chờ đối soát.
# Bỏ trống thì chỉ Admin tự vào Admin Portal mới thấy, không có cảnh báo qua email.
ADMIN_PAYMENT_ALERT_EMAIL=
