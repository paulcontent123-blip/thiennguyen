{
  "name": "thien-nguyen-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "node --env-file-if-exists=.env.local --use-system-ca node_modules/next/dist/bin/next build",
    "start": "node --env-file-if-exists=.env.local --use-system-ca node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo-users.mjs",
    "seed:demo-campaigns": "node --env-file=.env.local scripts/seed-demo-campaigns.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
